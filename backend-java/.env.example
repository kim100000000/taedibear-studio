# Spring Boot가 application.yml의 ${VAR:default} 플레이스홀더를 통해 읽는 환경변수.
# 실제 값이 담긴 .env / 환경변수 파일은 절대 커밋하지 마세요 (.gitignore에 .env 포함됨).

# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taedibear_studio
DB_USER=root
DB_PASSWORD=
JPA_DDL_AUTO=update

# JWT
# 필수! 미설정 시 부팅 실패 (C8). 'openssl rand -base64 48' 로 생성한 값 사용 (32바이트 이상)
JWT_SECRET=
# access token 수명 (기본 30분 — C4 refresh token 도입으로 단축)
JWT_EXPIRATION_MS=1800000

# 인증 쿠키 (C4 refresh token / C5 OAuth state)
# refresh token 수명 (기본 14일)
REFRESH_TOKEN_EXPIRATION_MS=1209600000
# 운영(HTTPS)은 둘 다 true, 로컬(http)은 false
OAUTH_COOKIE_SECURE=false
AUTH_COOKIE_SECURE=false
# 프론트와 백엔드가 서로 다른 도메인이면 None (None은 AUTH_COOKIE_SECURE=true 필수), 같으면 Lax
AUTH_COOKIE_SAME_SITE=Lax

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (소셜 로그인)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# AWS S3 (이미지 업로드)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=taedibear-studio-images

# Meta Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v19.0
META_REDIRECT_URI=http://localhost:4000/api/instagram/callback

# Kakao OAuth (소셜 로그인)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
# 카카오 콘솔 [내 애플리케이션 > 보안] 에서 Client Secret이 "사용함"이면 필수 (미설정 시 KOE010 로그인 실패)
# "사용 안 함"이면 비워둬도 됨
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/auth/kakao/callback

# Naver OAuth (소셜 로그인)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=http://localhost:4000/api/auth/naver/callback

# 토스페이먼츠
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key
TOSS_DEV_MODE=false

# 이메일 알림 (예약 실패 알림 / 관리자 일일 리포트) — 미설정 시 발송 스킵
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@taedibear.studio
ADMIN_EMAIL=