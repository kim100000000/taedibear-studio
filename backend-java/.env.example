# Spring Boot가 application.yml의 ${VAR:default} 플레이스홀더를 통해 읽는 환경변수.
# 실제 값이 담긴 .env / 환경변수 파일은 절대 커밋하지 마세요 (.gitignore에 .env 포함됨).

# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taedibear_studio
DB_USER=root
DB_PASSWORD=
JPA_DDL_AUTO=update

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRATION_MS=604800000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (소셜 로그인)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# AWS S3 (이미지 업로드)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=taedibear-studio-images

# Meta Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v19.0
META_REDIRECT_URI=http://localhost:4000/api/instagram/callback

# Kakao OAuth (소셜 로그인)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CALLBACK_URL=http://localhost:4000/api/auth/kakao/callback

# Naver OAuth (소셜 로그인)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=http://localhost:4000/api/auth/naver/callback
